<?xml version="1.0" encoding="utf-8"?>
<!-- Task progress dialog, same layout as Zomdroid's task_progress_dialog so every launcher shows
     long work the same way: title, one line of what is happening, a progress bar, and an OK button
     that appears only when the task ended with an error. LinearLayout instead of Zomdroid's
     ConstraintLayout — the project does not pull in that library for one dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/progress_dialog_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/progress_dialog_message_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_dialog_progress_lpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/progress_dialog_ok_mb"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="@android:string/ok"
        android:visibility="gone" />
</LinearLayout>
