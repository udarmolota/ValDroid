<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/launcher_fragment">

    <fragment
        android:id="@+id/launcher_fragment"
        android:name="com.valdroid.fragments.LauncherFragment"
        android:label="@string/nav_launcher" />

    <fragment
        android:id="@+id/settings_fragment"
        android:name="com.valdroid.fragments.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/app_settings_fragment"
        android:name="com.valdroid.fragments.AppSettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/new_instance_fragment"
        android:name="com.valdroid.fragments.NewInstanceFragment"
        android:label="@string/nav_new_instance" />

    <fragment
        android:id="@+id/download_fragment"
        android:name="com.valdroid.fragments.DownloadFragment"
        android:label="@string/nav_download_game" />

    <fragment
        android:id="@+id/cloud_saves_fragment"
        android:name="com.valdroid.fragments.CloudSavesFragment"
        android:label="@string/nav_cloud_saves" />

    <fragment
        android:id="@+id/install_content_fragment"
        android:name="com.valdroid.fragments.InstallContentFragment"
        android:label="@string/nav_install_content" />

    <fragment
        android:id="@+id/mods_fragment"
        android:name="com.valdroid.fragments.ModsFragment"
        android:label="@string/nav_mods" />

    <fragment
        android:id="@+id/thunderstore_fragment"
        android:name="com.valdroid.fragments.ThunderstoreFragment"
        android:label="@string/ts_menu" />

    <fragment
        android:id="@+id/driver_fragment"
        android:name="com.valdroid.fragments.DriverImportFragment"
        android:label="@string/nav_custom_driver" />

    <!-- Every import and export, one screen (as in Zomdroid and RimDroid); in the bottom bar. -->
    <fragment
        android:id="@+id/transfer_fragment"
        android:name="com.valdroid.fragments.TransferFragment"
        android:label="@string/transfer_title" />

    <!-- The author's other launchers (as in Zomdroid and RimDroid); in the bottom bar. -->
    <fragment
        android:id="@+id/projects_fragment"
        android:name="com.valdroid.fragments.ProjectsFragment"
        android:label="@string/projects_title" />

    <fragment
        android:id="@+id/multiplayer_fragment"
        android:name="com.valdroid.fragments.MultiplayerFragment"
        android:label="@string/nav_multiplayer" />

    <fragment
        android:id="@+id/bug_report_fragment"
        android:name="com.valdroid.fragments.BugReportFragment"
        android:label="@string/nav_bug_report" />

    <fragment
        android:id="@+id/icon_packs_fragment"
        android:name="com.valdroid.fragments.IconPacksFragment"
        android:label="@string/nav_icon_packs" />

    <fragment
        android:id="@+id/wiki_fragment"
        android:name="com.valdroid.fragments.WikiFragment"
        android:label="@string/nav_wiki" />

    <action android:id="@+id/action_settings"
        app:destination="@id/settings_fragment" />

    <action android:id="@+id/action_app_settings"
        app:destination="@id/app_settings_fragment" />

    <action android:id="@+id/action_install_instance"
        app:destination="@id/new_instance_fragment" />

    <action android:id="@+id/action_download_game"
        app:destination="@id/download_fragment" />

    <action android:id="@+id/action_cloud_saves"
        app:destination="@id/cloud_saves_fragment" />

    <action android:id="@+id/action_open_install"
        app:destination="@id/install_content_fragment" />

    <action android:id="@+id/action_open_mods"
        app:destination="@id/mods_fragment" />

    <action android:id="@+id/action_open_thunderstore"
        app:destination="@id/thunderstore_fragment" />

    <action android:id="@+id/action_open_custom_driver"
        app:destination="@id/driver_fragment" />

    <action android:id="@+id/action_open_transfer"
        app:destination="@id/transfer_fragment" />

    <action android:id="@+id/action_open_multiplayer"
        app:destination="@id/multiplayer_fragment" />

    <action android:id="@+id/action_open_bug_report"
        app:destination="@id/bug_report_fragment" />

    <action android:id="@+id/action_open_icon_packs"
        app:destination="@id/icon_packs_fragment" />

    <action android:id="@+id/action_open_wiki"
        app:destination="@id/wiki_fragment" />

</navigation>
